{
  "name": "dsh-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness plugins: one directory per plugin, written in TypeScript.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickdu2009/dsh-plugin.git"
  },
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "new": "node scripts/create-plugin.mjs",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
